# Archivo de ejemplo de configuración de vary.
# Cópialo a ~/.config/vary/vary.conf y ajusta según necesidad.
# Todas las claves son opcionales; los valores mostrados son los defaults.

[general]
# Directorio raíz de las cachés de vary. Contiene:
#   void-packages/  (checkout de void-packages usado por xbps-src)
#   cache.json      (caché de búsquedas/metadatos)
#   installed.json  (base de datos de paquetes gestionados por vary)
#   logs/           (registros de compilación)
cache_dir = "~/.cache/vary"

# Datos persistentes de vary: clones de repos VUR en vurs/, etc.
data_dir = "~/.local/share/vary"

# Nivel de detalle del log: "error", "warn", "info", "debug".
log_level = "info"

# Herramienta de elevación de privilegios para xbps-install/xbps-remove y
# escribir en /etc: sudo, doas o run0. Por defecto (vacío) se autodetecta
# en ese orden; ejecutando vary como root no se usa ninguna.
# Equivalente CLI: --sudo <bin>
#sudo_bin = ""

# Flags extra que se anteponen al wrapper. --sudoflags en CLI REEMPLAZA esta
# lista la primera vez (repetir --sudoflags acumula sobre lo dado en CLI).
#sudo_flags = []

# Binario curl para descargar índices remotos estilo VUP (index.json).
# Equivalente CLI: --curl <bin>
#curl_bin = "curl"

[tools]
# Binario `install` (coreutils) usado para escribir en /etc con elevación.
#install_bin = "install"

[build]
# Builds paralelos por niveles topológicos (P1-3): >1 SOLO con --experimental
# en 0.4.1 (puerta de validación; sin ella siempre secuencial). Requiere
# overlayfs + 1 GiB libre en caché; sin capacidad degrada a secuencial con
# aviso. Ojo: slots × makejobs pueden sobresuscribir CPU (ajustar a mano).
max_concurrent_builds = 2

# Recompilar desde fuente aunque exista binario firmado o caché válida
# (equivalente a pasar --force-build en cada operación).
force_rebuild = false

# Compilación híbrida: paquetes OFICIALES que siempre se compilan desde
# fuente (globs simples `*`/`?`, case-sensitive; sin regex). Un paquete
# oficial que matchee se emite como build source: xbps-src resuelve sus
# dependencias (binario si existe, compila lo que falte) y el plan no las
# expande. Si un repo VUR también lo provee, manda la precedencia VUR, pero
# compilado desde fuente: el binario firmado VUR nunca gana para un match.
#source_always = ["linux*", "mesa-*", "gcc"]

[make]
# Ajustes de compilación que se inyectan en un conf de xbps-src por
# invocación (`etc/conf.vary-<id>` + `xbps-src -c`). NO se fusiona con tu
# `void-packages/etc/conf` existente: en esa invocación lo reemplaza.
# `makejobs` sigue en [build] (XBPS_MAKEJOBS); no va aquí.
#
# Variables XBPS_* soportadas (al chroot solo pasan líneas XBPS_):
#   XBPS_CFLAGS / XBPS_CXXFLAGS / XBPS_LDFLAGS / XBPS_CCACHE /
#   XBPS_DISTCC / XBPS_DISTCC_HOSTS / XBPS_PKG_OPTIONS /
#   XBPS_PKG_OPTIONS_<pkg> / XBPS_DEBUG_PKGS / XBPS_CHECK_PKGS /
#   XBPS_ALLOW_RESTRICTED.
#
# Limitación: RUSTFLAGS/CIFLAGS no se propagan nativamente (xbps-src hace
# unset RUSTFLAGS y no existe XBPS_RUSTFLAGS).
#
#cflags = "-O2 -pipe"
#cxxflags = ""
#ldflags = ""
#ccache = false
#distcc = false
#distcc_hosts = "localhost/4"
#global_options = ["static"]   # XBPS_PKG_OPTIONS global
#debug_pkgs = false
#check_pkgs = false
#allow_restricted = false

[options]
# Opciones por paquete -> XBPS_PKG_OPTIONS_<pkg> (el nombre se normaliza
# a [A-Za-z0-9_]; `foo-bar` => XBPS_PKG_OPTIONS_foo_bar). Solo aplica a los
# paquetes que vary compila.
# Las claves con punto se CITAN en TOML: ["foo.bar"] = ["opt"].
#linux = ["pgo", "wayland", "~jack"]

[search]
# Tiempo de vida (en segundos) de las entradas de la caché de búsqueda
# (cache.json). Caducadas, la próxima búsqueda vuelve a consultar los repos.
ttl_cache_seconds = 3600

# NOTA: los repos VUR no se declaran aquí; se gestionan en
# ~/.config/vary/repos.conf (o con `vary --repo add|list|remove`).
